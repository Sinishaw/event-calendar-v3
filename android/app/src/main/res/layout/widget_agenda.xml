<?xml version="1.0" encoding="utf-8"?>
<!-- Android port of the iOS Large agenda widget. Solid theme-aware card
     (white in light mode / dark in night mode); ET date (left) and GC date
     (right) in the top corners with the day on top and weekday+month/year on a
     single line below; a light divider; up to 4 color-coded upcoming events,
     each on a faint tint of its color; a "+" at the bottom to add.
     Rows are toggled/filled/tinted and each is made tappable by
     AgendaWidgetProvider. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_glass_bg"
    android:padding="12dp"
    tools:ignore="UnusedAttribute">

    <!-- Top corners: ET (left) / GC (right); day on top, rest below -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="start">
            <TextView android:id="@+id/tv_ag_et_day"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="@color/widget_text_primary"
                android:textStyle="bold" android:includeFontPadding="false"
                android:textSize="34sp" />
            <TextView android:id="@+id/tv_ag_et_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/widget_text_secondary" android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">
            <TextView android:id="@+id/tv_ag_gc_day"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="@color/widget_text_primary"
                android:textStyle="bold" android:includeFontPadding="false"
                android:textSize="34sp" />
            <TextView android:id="@+id/tv_ag_gc_sub"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:ellipsize="end"
                android:textColor="@color/widget_text_secondary" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Light separator between header and body -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider"
        android:contentDescription="@null" />

    <!-- Agenda list (up to 4 rows) / empty state -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView android:id="@+id/tv_ag_empty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:maxLines="1" android:visibility="gone"
            android:textColor="@color/widget_text_secondary" android:textSize="13sp" />

        <LinearLayout android:id="@+id/agenda_row_0"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:minHeight="32dp"
            android:padding="4dp" android:layout_marginBottom="4dp" android:visibility="gone">
            <ImageView android:id="@+id/agenda_bar_0"
                android:layout_width="4dp" android:layout_height="match_parent"
                android:background="#009900" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_ag_title_0"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/tv_ag_detail_0"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_ag_time_0"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:layout_marginStart="6dp" android:gravity="end"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/agenda_row_1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:minHeight="32dp"
            android:padding="4dp" android:layout_marginBottom="4dp" android:visibility="gone">
            <ImageView android:id="@+id/agenda_bar_1"
                android:layout_width="4dp" android:layout_height="match_parent"
                android:background="#009900" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_ag_title_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/tv_ag_detail_1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_ag_time_1"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:layout_marginStart="6dp" android:gravity="end"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/agenda_row_2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:minHeight="32dp"
            android:padding="4dp" android:layout_marginBottom="4dp" android:visibility="gone">
            <ImageView android:id="@+id/agenda_bar_2"
                android:layout_width="4dp" android:layout_height="match_parent"
                android:background="#009900" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_ag_title_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/tv_ag_detail_2"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_ag_time_2"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:layout_marginStart="6dp" android:gravity="end"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout android:id="@+id/agenda_row_3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:minHeight="32dp"
            android:padding="4dp" android:visibility="gone">
            <ImageView android:id="@+id/agenda_bar_3"
                android:layout_width="4dp" android:layout_height="match_parent"
                android:background="#009900" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp" android:gravity="center_vertical">
                <TextView android:id="@+id/tv_ag_title_3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end" android:textStyle="bold"
                    android:textColor="@color/widget_text_primary" android:textSize="14sp" />
                <TextView android:id="@+id/tv_ag_detail_3"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="1" android:ellipsize="end"
                    android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
            </LinearLayout>
            <TextView android:id="@+id/tv_ag_time_3"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:layout_marginStart="6dp" android:gravity="end"
                android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-center "+" to add an event -->
    <TextView
        android:id="@+id/btn_ag_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="+"
        android:textColor="@color/widget_text_primary"
        android:textStyle="bold"
        android:textSize="26sp"
        android:includeFontPadding="false"
        android:paddingHorizontal="10dp" />
</LinearLayout>
